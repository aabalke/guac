//kage:unit pixels
package main

var (
    ColorMatrix mat3
    Percent     float
    Gamma       float
)

func Fragment(_ vec4, src vec2, _ vec4) vec4 {
    original := imageSrc0At(src)
    c := pow(original.rgb, vec3(Gamma))
    color := ColorMatrix * c
    color = pow(color, vec3(1.0/2.2))
    color = clamp(color, 0, 1)
    original.rgb = mix(original.rgb, color, Percent)
    return original
}
